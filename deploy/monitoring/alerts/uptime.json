{
  "displayName": "Cogfab is unavailable",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Health check fails from multiple regions",
      "conditionThreshold": {
        "aggregations": [
          {
            "alignmentPeriod": "120s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER",
            "crossSeriesReducer": "REDUCE_COUNT_FALSE",
            "groupByFields": ["resource.label.*"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "duration": "120s",
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id=\"UPTIME_CHECK_ID\" AND resource.type=\"uptime_url\"",
        "thresholdValue": 1,
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "documentation": {
    "content": "Check https://cogfab.io/healthz, then inspect the `cogfab` container on the production VM.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "service": "cogfab"
  }
}
